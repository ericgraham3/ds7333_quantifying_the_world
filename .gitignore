# Ignore everything at the root level by default
/*

# Un-ignore the code directory and this file
!.gitignore
!code/

# Within code/, exclude document/output file types
code/**/*.pdf
code/**/*.docx
code/**/*.html
code/**/*.md
code/**/*_files/

# Python
code/**/__pycache__/
code/**/*.py[cod]
code/**/*.pyo
code/**/*.egg-info/
code/**/.eggs/
code/**/dist/
code/**/build/

# Jupyter
code/**/.ipynb_checkpoints/

# Virtual environments
code/**/.venv/
code/**/venv/
code/**/env/

# IDE
code/**/.idea/
code/**/.vscode/

# OS
code/**/.DS_Store
code/**/Thumbs.db

# Model checkpoints
code/**/*.ckpt

# Oversized data files
code/case_study_06/all_train.csv
code/final_case_study/final_project(5).csv

# Raw datasets (downloaded, not authored)
code/case_study_03/SpamAssassinMessages/
